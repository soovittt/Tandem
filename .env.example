# Copy this file to `.env` and fill in your keys. `.env` is gitignored.

# --- Model (required) ---
# Which provider preset: "nebius" (hackathon requirement) or "nvidia" (free dev).
LLM_PROVIDER=nebius
# Your API key for that provider. REQUIRED.
LLM_API_KEY=
# Optional overrides. Leave blank to use the preset defaults (see config.py).
LLM_BASE_URL=
LLM_MODEL=

# --- Web search (optional) ---
# If set, the web_search tool is enabled. Get a free key at tavily.com.
TAVILY_API_KEY=

# --- Memory backend (optional) ---
# "mem0"   = semantic AI memory (self-hosted, needs `uv sync --extra mem0`)
# "sqlite" = keyword fallback, zero extra deps (default)
MEMORY_BACKEND=sqlite

# --- Storage (optional) ---
# Where local memory + skills live. Defaults to ./.tandem
TANDEM_DATA_DIR=
